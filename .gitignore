# ---- build artefacts -------------------------------------------------------
*.o
*.a
*.d
build/
bench/bench
bench/bench_*
bench_bench_*

# ---- editor / tool droppings -----------------------------------------------
*.tmp
.DS_Store
.freebuff/

# ---- measurement output: current runs and superseded campaigns -------------
# Kept on disk as evidence, never in history: a log a reader cannot re-derive is
# not a record. The frozen CSVs under docs/data/ are the record.
results/live/
results/archive/
results/*.csv
results/*.log
results/*.svg

# ---- the VPS working record ------------------------------------------------
# Phase reports, analysis prints, codegen dumps and the campaign/report/measure
# scripts that produced them. The public record is docs/, and the frozen CSVs
# under docs/data/ are what ships from the campaigns.
results/docs/
scripts/analyze/
scripts/campaign/
scripts/measure/
scripts/report/
scripts/verify/

# ---- kernels that stayed on the VPS ----------------------------------------
# The public tree is the curated subset (src/fast.c, src/mid.c, src/rungs/).
# Every other candidate rung, and the perf6 probe TUs, live only on the VPS.
src/memcpy/
src/perf6/
.recon/

# ---- but the frozen record IS tracked --------------------------------------
# (explicit negations: a record that is gitignored is not a record)
!docs/data/
!docs/data/*.csv
!docs/data/raw/
!docs/data/raw/*.windows.log
!docs/data/raw/ladder/
!docs/data/raw/ladder/*.windows.log
!experiments/hybrid/data/
!experiments/hybrid/data/*.csv

# ---- the documented-loss experiment ----------------------------------------
experiments/hybrid/data/live/
experiments/hybrid/route_check
experiments/hybrid/bench_hybrid
